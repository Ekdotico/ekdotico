# Settings for development. Never commit a real value, and never a real address.
#
# Copy this to .env.local. The web application loads that file itself
# (`pnpm dev`, `pnpm start`), and `pnpm dev:collab` hands it to the collaboration
# server. `pnpm start:collab`, the migrations and the integration tests read the
# environment of the shell that starts them, so pass their values on the command
# line, as README.md shows.
#
# A process refuses to start where one of the five settings below is absent.

# The founding team's addresses, separated by commas (FR-AU-83). A list with no
# address is an empty value.
FOUNDING_TEAM_EMAILS=

# The origin the application is served from: the one origin a request that
# changes state may come from (NFR-SE-17 (c)). https, except on localhost.
APP_ORIGIN=http://localhost:3000

# The runtime role, ekdotico_app (NFR-IC-17). The password local-app is the one
# given to scripts/provision.sql on a development machine and exists nowhere else.
DATABASE_URL=postgresql://ekdotico_app:local-app@localhost:5432/ekdotico

VALKEY_URL=redis://localhost:6379

# The identity library's secret, at least 32 characters, different in every
# environment (NFR-SE-17 (e)). `node scripts/dev-secret.mjs` prints a fresh one.
AUTH_SECRET=

# The key of the signed admission requests (FR-AU-89), at least 43 characters of
# the URL-safe alphabet; `node scripts/dev-secret.mjs` prints one. Without it
# every admission request is refused, and no account can be created.
ADMISSION_SECRET=

# Required away from a development machine, that is wherever APP_ORIGIN is not
# on localhost; optional on one:
#
# EMAIL_TRANSPORT=sink            the only value: each message is written to a file, and none is sent
# EMAIL_SINK_DIRECTORY=.local/mail  where the files go; they hold addresses and single-use links
# TRUSTED_PROXY_COUNT=1           how many proxies stand in front of the process, 1 or more: a
#                                 client's address is the entry of X-Forwarded-For that the
#                                 outermost of them wrote, counted from the right. A process
#                                 refuses to start with 0 away from localhost. On localhost it
#                                 is 0 where left out, and every request without a session then
#                                 shares one count of NFR-SE-07 (docs/operations/deployment.md)

# The object store of the images (NFR-SE-18): DigitalOcean Spaces in FRA1 in production, a local
# S3-compatible store on a development machine. All four or none: with none, a development machine
# stores no image, and a deployment that sets none says so at start. The origin a page loads an image from
# is derived from them and is the one origin the Content-Security-Policy names besides its own.
#
# IMAGE_STORAGE_ENDPOINT=http://localhost:8333    https, except on localhost; an origin and nothing after it
# IMAGE_STORAGE_BUCKET=ekdotico-images            the bucket admits no public read and no listing
# IMAGE_STORAGE_ACCESS_KEY_ID=
# IMAGE_STORAGE_SECRET_ACCESS_KEY=                different from every other secret
# IMAGE_STORAGE_REGION=fra1                       where left out
#
# Optional, each with its initial value:
#
# SESSION_IDLE_SECONDS=604800     FR-AU-84: 7 days after the last renewal
# SESSION_RENEW_SECONDS=86400     FR-AU-84: renewed at most once in 24 hours
# SESSION_MAX_SECONDS=2592000     FR-AU-84: 30 days after it began
# COOKIE_CACHE_SECONDS=60         NFR-SE-17 (c)
# PASSWORD_MIN_LENGTH=8           FR-AU-82; the owner's decision of 8 October 2026
# PASSWORD_MAX_LENGTH=32          FR-AU-82; the owner's decision of 8 October 2026
# PASSWORD_LIST_FILE=data/common-passwords.txt  FR-AU-82: the known passwords, one to a line
# TWO_FACTOR_STEP_SECONDS=600     FR-AU-83: the second step of a sign-in, and the first code of an enrolment, 10 minutes from the password
# TWO_FACTOR_WRONG_CODES=5        NFR-SE-07: the wrong codes of one sign-in, or of one enrolment, before it begins again
# SIGN_IN_LOCK_SECONDS=3600       FR-AU-81: how long the twentieth failed sign-in locks an account, and how long the link of its email is valid; no less than the seconds of RATE_LIMIT_FAILED_SIGN_IN_PER_EMAIL, or the process does not start
# SECURITY_LOG_RETENTION_DAYS=30  NFR-SE-19
# DELETED_DOCUMENT_RETENTION_DAYS=30  FR-ED-36: a deleted document can be restored for this long; 1 to 3650.
#   LOWERING it applies to the documents already deleted: at the next run of the timer every document
#   deleted longer ago than the new value is deleted permanently, although its Owner was shown the old date.
#   Every instance must be given the same value, and their clocks must agree (docs/operations/deployment.md).
# IMAGE_DOCUMENT_MEGABYTES=100    NFR-SE-18: the most a document holds of images, every stored object counted, 1 or more
# IMAGE_UNREFERENCED_DAYS=30      NFR-SE-18: an image that no longer appears in its document is deleted this long after it left
# IMAGE_LINK_SECONDS=300          NFR-SE-18: a link to an image is valid this long, 1 to 3600
# ADMISSION_INVITATION_DAYS=30    FR-AU-89 (a)
# DOCUMENT_INVITATION_DAYS=14     FR-ED-37: a document invitation is pending this long
# INVITATION_REMINDER_DAYS=3      FR-ED-48: the one reminder of a document invitation comes this many days before its expiry
# DOCUMENT_INVITATION_ADDRESS_DAYS=30  FR-ED-37: the address of a declined, revoked, or expired document invitation is cleared this long after it ended
# OWNERSHIP_OFFER_DAYS=14        FR-ED-47: an offer of ownership is pending this long
# FEEDBACK_INTAKE_ENABLED=false   FR-AU-58 (c), D112: the step of an account deletion that instructs the feedback intake of Praktico.
#   OFF in α 0.1.0: the step makes no call and is recorded as skipped. Only `true` and `false` are read; anything else makes the step
#   fail. Turn it on in the release that adds the Feedback Widget, which brings the client of the request; turned on before then,
#   every deletion stops at that step and is repeated (src/lib/account/feedback-step.ts, the one file that reads it).
# EMAIL_FROM=Ekdotico <no-reply@localhost>
# RATE_LIMIT_<NAME>=max/seconds   NFR-SE-07; the names are in src/lib/settings.ts
# COLLAB_STORE_DELAY_MS=2000      NFR-RE-07: a document is stored this long after its last change; at least 1000
# COLLAB_STORE_MAX_MS=10000       NFR-RE-07: and this often while changes continue; at least twice the other and 1000 more
# COLLAB_ERROR_AFTER_MS=30000     FR-ED-23: the editor shows the error state when a lost connection is not restored in this long
# COLLAB_EVENTS_CHANNEL=...       The Valkey channel of the events for the collaboration server (FR-ED-40). Leave it unset: the tests
#   give each run a name of its own so that runs on one machine do not hear each other. Every process must be given the same name.
#
# Development only: where the collaboration server listens, so that `pnpm dev` serves /collab on the
# application's own origin (README.md). Read by the build, which holds the rewrite from then on. The
# build is refused unless APP_ORIGIN and this are on localhost, and a start is refused where APP_ORIGIN
# is not on localhost and this is set or the build holds the rewrite. A deployment's reverse proxy
# does this instead (docs/operations/deployment.md).
# COLLAB_PROXY_TARGET=http://127.0.0.1:1234

# Read from the shell, not from this file:
#
# COLLAB_PORT=1234
# ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# MIGRATE_DATABASE_URL=postgresql://ekdotico_migrate:local-migrate@localhost:5432/ekdotico?schema=ekdotico
#
# The passwords local-migrate, local-app and local-backup are the ones given to
# scripts/provision.sql on a development machine and exist nowhere else.
