# Copy to .env.local for development. Never commit a real value, and never a real address.

# The founding team's addresses, separated by commas (FR-AU-83). A process refuses
# to start where this is absent; a list with no address is an empty value.
FOUNDING_TEAM_EMAILS=

# Step (c) of an account deletion (FR-AU-58). Off in α 0.1.0. It is switched on
# in the release that adds the Feedback Widget: see CLAUDE.md.
FEEDBACK_INTAKE_ENABLED=false

# The collaboration server's port.
COLLAB_PORT=1234

# Local database, as compose.yaml starts it. The three passwords are the ones
# given to scripts/provision.sql below and exist only on a development machine.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ekdotico
MIGRATE_DATABASE_URL=postgresql://ekdotico_migrate:local-migrate@localhost:5432/ekdotico?schema=ekdotico
