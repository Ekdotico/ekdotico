// The application's schema. The schema `ekdotico`, its roles and its grants are
// created by scripts/provision.sql and never by a migration (contract IC-51).
// No `vector` extension is declared: α 0.1.0 stores none (contract IC-23).
// A model arrives with the slice that first uses it, and of a model only the
// columns that slice uses (Data models, "What α 0.1.0 migrates"). `Verification`
// and `TwoFactor` arrive unused: the identity library refuses to start without them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity ────────────────────────────────────────────────────────────────
// The five tables of the identity library, Better Auth, in the application
// schema (FR-AU-05, NFR-SE-17 (b)). Their names and columns follow the library
// at its pinned version, 1.7.7, and were checked against it when it was
// installed (register D96). `User` is the library's table, extended.

model User {
  id            String   @id
  // Null only on the tombstone of a deleted account (FR-AU-58 (e)).
  name          String?
  // Lower case; unique without regard to case because it is stored lower case (FR-AU-02).
  email         String?  @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  twoFactorEnabled Boolean @default(false)

  // FR-AU-81: sign-in is refused until this time, after the twentieth failed
  // sign-in in any hour. Set by the server alone (NFR-SE-17 (d)); null, or a
  // time that has passed, is no lock (src/lib/auth/sign-in-lock.ts).
  lockedUntil DateTime?

  // The acknowledgement of the Closed α notice (FR-AU-56): the server time it
  // was made and the version of the notice acknowledged. Both null until the
  // account acknowledges.
  closedAlphaNoticeAcknowledgedAt DateTime?
  closedAlphaNoticeVersion        Int?

  // The acknowledgement of the feedback notice (FR-AU-95): the server time and the version, as for the Closed α
  // notice. Both null until the account acts on "Continue".
  feedbackNoticeAcknowledgedAt DateTime?
  feedbackNoticeVersion        Int?

  // When the Onboarding paper was made for this account, once and for ever: set in the
  // transaction that inserts it, and never cleared, so that a paper the person deleted is not
  // made again (src/lib/documents/onboarding-paper.ts). Null until then.
  onboardingPaperSeededAt DateTime?

  // FR-AU-58 (e): when the personal fields of the row were cleared. Null for an
  // account in use. With its `id` and the two columns above, it is what the
  // tombstone keeps; `createdAt` and `updatedAt` are the table's own and cannot
  // be dropped (docs/plan/slice-22.md, row S22-3).
  erasedAt DateTime?

  // FR-AU-58: the record of a confirmed deletion, which stays with the tombstone.
  deletion          AccountDeletion?
  sessions          Session[]
  accounts          Account[]
  twoFactor         TwoFactor?
  // FR-AU-09: at most one, by the unique `Workspace.ownerId`.
  personalWorkspace Workspace?             @relation("PersonalWorkspace")
  // FR-ED-19: the documents the account is the Owner of.
  ownedDocuments    Document[]             @relation("DocumentOwner")
  // FR-ED-19, FR-ED-21, FR-ED-42: the roles held through an accepted
  // invitation, the invitations made, and the notifications received.
  collaborations    DocumentCollaborator[]
  invitationsMade   DocumentInvitation[]   @relation("InvitedBy")
  notifications     Notification[]
  // D263: emails waiting to be tried again for this account.
  emailRetries      EmailRetry[]
  // FR-ED-47: the offers of ownership the account made and received.
  offersMade        OwnershipOffer[]       @relation("OfferedBy")
  offersReceived    OwnershipOffer[]       @relation("OfferedTo")
  // FR-AU-91: the clearings of its documents that the account confirmed.
  clearings         DocumentClearing[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row for each credential of a user. The only provider is `credential`,
// whose row holds the salted scrypt hash of the password (NFR-SE-17 (a)).
model Account {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  accountId  String
  password   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // The library's columns for OAuth tokens. No OAuth is installed, so they stay
  // null, and a test asserts it; but the library refuses to start without them.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// The secret and the recovery codes are stored encrypted under a key held in
// the environment (NFR-SE-17 (a)). The last three columns are the library's own
// at 1.7.7 and are not on the Data models page. `verified` is false from the
// password of an enrolment to its first code, and only a verified row is a
// second factor (FR-AU-83: "only then is it on"). The other two belong to a
// lock of the library's own, which nothing here reaches: the codes are checked
// by the application's endpoints (src/lib/auth/two-factor.ts), and the only
// count is that of NFR-SE-07. They stay 0 and null, and a test asserts it.
// `verified` is false unless a writer says otherwise (the library's default is
// true): a row written without it is no second factor.
model TwoFactor {
  id                      String    @id
  // One row for an account (Data models): an enrolment begun again replaces it.
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  // When the password began the enrolment, and again each time it is begun
  // again: a secret waits for its first code no longer than a second step
  // waits for its code (two-factor.ts). Not on the Data models page.
  createdAt               DateTime  @default(now())

  @@index([secret])
}

// ── Security log ────────────────────────────────────────────────────────────
// One row for each event NFR-SE-19 lists. An entry holds the time, the kind,
// the application's user identifier and the document identifier, "and nothing
// else about a person": a column added here is how personal data would get in,
// and a test fails on one. The kinds are text, listed in src/lib/security-log.ts.
//
// No relation to `User` or to a document, on purpose: an entry outlives the
// row it names (a deleted document, a tombstone), and a sign-in refused for an
// unknown address has no user. Entries are deleted after their retention, by
// the time, hence the index (NFR-RE-15).
model SecurityLogEntry {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  kind       String
  // The identity library's identifier of a user (`User.id`).
  userId     String?
  // `Document.id`, a UUID.
  documentId String?  @db.Uuid

  @@index([createdAt])
}

// ── Admission ───────────────────────────────────────────────────────────────
// One row for each invitation by which the team admits a person to Closed α
// (FR-AU-89), created on a signed request. The link's token is stored only as
// a hash, and `requestId` makes a repeated request harmless. On acceptance the
// address becomes `User.email`.
//
// `state` is what was last written. "Expired" is told from `expiresAt` when a
// row is read (src/lib/admission/invitations.ts), so that an invitation is
// never open a moment past its expiry for want of a timer; EXPIRED is written
// only when the row is next changed.
//
// The migration adds what this file cannot say: a unique index on `email`
// over the PENDING rows alone, so that an address never has two open links.
model AdmissionInvitation {
  id           String         @id @default(cuid())
  // Null once cleared: 30 days after `revokedAt` or `expiresAt`, and when the
  // account made from it is deleted (FR-AU-58 (e), NFR-RE-15; a later slice).
  email        String?
  tokenHash    String         @unique
  requestId    String         @unique
  state        AdmissionState @default(PENDING)
  createdAt    DateTime       @default(now())
  expiresAt    DateTime
  // Not on the Data models page: the clearing of the address counts its 30
  // days from the revocation, which no other column records.
  revokedAt    DateTime?
  acceptedAt   DateTime?
  // The `User` created from it. No relation: the row outlives a tombstone.
  acceptedById String?

  @@index([email])
}

// The nonce of a signed admission request that was accepted (FR-AU-89; register D299, Q82 point 4): inserted once
// the signature and the time verify, under the primary key, so that of two copies of a request exactly one is
// accepted, and kept until the signed time is more than 5 minutes in the past (`expiresAt`), when the hourly
// clearing of admission addresses deletes it (src/lib/admission/nonce.ts). The nonce is a random value of at
// least 128 bits that the caller makes for the request, and it holds no personal field. Not on the Data models
// page, which is owed the row.
model AdmissionNonce {
  nonce     String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

enum AdmissionState {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ── Workspaces ──────────────────────────────────────────────────────────────
// Personal workspaces only in this slice (Data models, "What α 0.1.0
// migrates"). A personal workspace is tied to its account by `ownerId`, which
// is unique, so an account never has two (FR-AU-09; register D61).
model Workspace {
  id        String        @id @default(cuid())
  type      WorkspaceType
  ownerId   String?       @unique
  createdAt DateTime      @default(now())

  owner     User?      @relation("PersonalWorkspace", fields: [ownerId], references: [id], onDelete: Restrict)
  documents Document[]
}

enum WorkspaceType {
  PERSONAL
  INSTITUTIONAL
}

// ── Documents ───────────────────────────────────────────────────────────────
// The columns of the slice that creates, lists and renames a document (Data
// models, "What α 0.1.0 migrates"), and `yjsState`, of the collaboration
// server. `deletedById` arrives with deletion, and `clearingAt` with the
// clearing of an account's documents.
//
// Neither relation deletes a document: a document goes by its own deletion
// (FR-ED-36) and never because its Owner's row or its workspace's row went
// (plan, C17).
//
// The migration adds what this file cannot say: that a title has 1 to 200
// characters.
model Document {
  // FR-ED-35: a UUID in canonical lower-case text, which is how PostgreSQL
  // writes one (contract IC-25). Version 4, issued by the database (plan, C16).
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // FR-AU-13: never changed after creation, but for a transfer of ownership.
  workspaceId       String
  // FR-ED-19: exactly one Owner, by `User.id` and never by an address (FR-AU-04).
  ownerId           String
  // FR-ED-35: at most 200 characters. Stored as written (NFR-SE-08).
  title             String         @default("Untitled document")
  // FR-ED-44, FR-ED-45: the permission set, stored whole: every permission of
  // the table for every role, the Reviewer column and the comment rows
  // included, written at creation with the defaults. A column and not rows,
  // because the set is read with the document on every request (FR-ED-39) and
  // is always read and written whole. Its form is in
  // src/lib/documents/permissions.ts, which is also the only reader: a cell the
  // table fixes is decided from the table, whatever is stored here.
  permissionSet     Json
  // NFR-RE-07: the document's live state, written by the collaboration server
  // and by nothing else. Null until the document is first stored. The encoding
  // is in src/lib/collab/state.ts, and only there.
  yjsState          Bytes?
  // FR-ED-43, contract IC-16: fixed at creation from the capability the
  // Istorico port reports, and never changed. No default, so that no row is
  // written without the capability having been read.
  recording         RecordingState
  // FR-ED-36: the soft deletion (Data models, "Soft delete"): when the Owner
  // deleted the document, and who did. Both null for a document that is not
  // deleted, and again after it is restored. The row and its state stay for
  // the retention, and are then deleted by the timer
  // (src/lib/documents/deletion.ts). `deletedById` is an identifier and no
  // relation, as the page has it. The index below is the two lists' (plan, C17).
  deletedAt         DateTime?
  deletedById       String?
  // NFR-RE-15, plan C8: the claim of the permanent deletion, so that with two
  // instances one of them deletes the document. Set by the instance that
  // takes it, and never cleared but where Istorico did not erase; a claim
  // that was not finished is taken over once it is an hour old. NOT on the
  // Data models page: reported to the owner, with the plan's choice.
  deletionClaimedAt DateTime?
  // FR-AU-91, FR-ED-40 (i), register A103: the day on which a clearing of its Owner's documents deletes
  // this one, a copy of `DocumentClearing.deleteSharedAt`, which is the source of the day. While it is
  // set the document is read-only for everyone, the Owner included, no invitation is created, and it
  // is not renamed, deleted by hand or restored (src/lib/clearing/period.ts). For a document that is
  // not shared, the time of the confirmation (docs/plan/slice-23.md, S23-2). Null again where the
  // clearing is cancelled for the document or its ownership passes to another account.
  clearingAt        DateTime?
  createdAt         DateTime       @default(now())
  // When the document was last EDITED: created, renamed, or its state stored.
  // Not `@updatedAt`, under which every write moves it, the deletion, the
  // restore and the claim among them, unless each remembers to pass the old
  // value (FR-ED-36: a restore returns the document "as it was at deletion").
  // The three writes that are edits set it themselves, and no other write
  // names it. The attribute is the client's and no part of the database, so
  // the column is as the migration made it: required, with no default.
  updatedAt         DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  owner     User      @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  collaborators DocumentCollaborator[]
  invitations   DocumentInvitation[]
  offers        OwnershipOffer[]
  images        DocumentImage[]

  @@index([ownerId, deletedAt])
}

// ─── Sharing (FR-ED-19, FR-ED-21, FR-ED-37; Data models, "Sharing") ─────────

// A role other than the Owner's, held through an accepted invitation. The
// Owner is Document.ownerId and has no row here. The permanent deletion of the
// document deletes the row with it (FR-ED-36).
model DocumentCollaborator {
  id         String       @id @default(cuid())
  documentId String       @db.Uuid
  userId     String
  role       DocumentRole
  addedAt    DateTime     @default(now())
  // When the current role was granted (FR-AU-92); set again whenever role changes.
  roleSince  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([documentId, userId])
  @@index([userId])
}

enum DocumentRole {
  EDITOR
  REVIEWER
  VIEWER
}

// One row for every address an inviter enters (FR-ED-21, FR-ED-37). The token
// of the link is stored only as its hash. emailClaimedAt is set before the one
// email is handed to the service and a row with it set is never sent again; a
// row whose address had no account keeps it null and is sent to no one.
// "Expired" is derived from expiresAt, and written by the next write that
// meets the row. By hand in the migration: one PENDING row for an address and
// a document, and the address in lower case.
//
// Two departures from Data models (docs/plan/slice-13.md, S13-7): acceptedById,
// since FR-ED-37 refuses "an address at which a user who holds a role on the
// document accepted"; and the relation of invitedById.
model DocumentInvitation {
  id                String          @id @default(cuid())
  documentId        String          @db.Uuid
  email             String?
  role              DocumentRole
  invitedById       String
  tokenHash         String          @unique
  state             InvitationState @default(PENDING)
  createdAt         DateTime        @default(now())
  expiresAt         DateTime
  respondedAt       DateTime?
  acceptedById      String?
  emailClaimedAt    DateTime?
  reminderClaimedAt DateTime?
  // D202, Q49: the words that stand for the document's title when the inviter hid it from the invitee, made
  // once when the invitation is created ("Flying Hippos — {display name}") and shown on the page, in the
  // notification and in the email. Null is "the title is shown"; it is never the title itself.
  // PERSONAL DATA: it holds a copy of the sender's display name (or, where there is none, the local part of
  // the sender's address), which nothing clears. Slice 22 (account deletion, FR-AU-58) must clear or replace
  // it on the invitations of a deleted sender, and the invitation's own clearing of the address (FR-ED-37)
  // does not reach it. The Data models page is owed an amendment for D207 (this column and its meaning).
  titlePseudonym    String?

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([documentId, email])
}

enum InvitationState {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

// In-application notifications (FR-ED-42). The payload carries identifiers and
// never content: for an invitation, `{ "invitationId": … }`. A read
// notification keeps its row; the row is deleted when its subject no longer
// exists.
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  kind        String
  payload     Json
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId, readAt])
  // The timers delete by kind and age (P-09).
  @@index([kind, createdAt])
}

// ─── Transfer of ownership (FR-ED-47; Data models, "Offers of ownership") ───

// One row for each offer of ownership. Ownership changes only when the Editor
// named in toUserId accepts. expiresAt is 14 days after createdAt (a setting);
// "expired" is derived from it and written by the timer or the next write that
// meets the row. emailClaimedAt keeps the email from being sent twice, as on
// an invitation. By hand in the migration: at most one PENDING offer for a
// document, and fromUserId is not toUserId.
//
// Departures from Data models (docs/plan/slice-17.md, S17-8): the relations
// of fromUserId and toUserId to User, and onDelete: Cascade from the document
// (its permanent deletion, FR-ED-36, deletes the row).
model OwnershipOffer {
  id             String              @id @default(cuid())
  documentId     String              @db.Uuid
  fromUserId     String
  toUserId       String
  state          OwnershipOfferState @default(PENDING)
  createdAt      DateTime            @default(now())
  expiresAt      DateTime
  respondedAt    DateTime?
  emailClaimedAt DateTime?
  // The transfer of all documents (FR-AU-92) that made the offer; null for an offer made on its own. It
  // groups the one email to each person offered, and lists the documents of the action that were accepted.
  batchId        String?             @db.Uuid

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  from     User     @relation("OfferedBy", fields: [fromUserId], references: [id], onDelete: Restrict)
  to       User     @relation("OfferedTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([documentId, state])
  @@index([toUserId, state])
}

// D263, NFR-RE-15: an email that the service certainly did not take, waiting to be tried again. The kind, the
// subject, and the account, and nothing else: no address, no link, no content. The email is made again from the
// rows it names when it is tried.
model EmailRetry {
  id        String         @id @default(cuid())
  kind      EmailRetryKind
  // The invitation, the offer, the batch of offers, or the clearing that the kind names.
  subjectId String
  userId    String
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([kind, subjectId, userId])
  @@index([createdAt])
  // The cascade from User reads by account.
  @@index([userId])
}

enum EmailRetryKind {
  INVITATION
  REMINDER
  OFFER
  OFFER_BATCH
  CLEARING
}

enum OwnershipOfferState {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum RecordingState {
  RECORDED
  UNRECORDED
}

// ─── Images (FR-ED-08, NFR-SE-18; Data models, "Images") ────────────────────

// One row for each uploaded image. The document refers to an image by its id
// and never by an address; the object is in the storage under objectKey, which
// names its document and is never in the document. The byteSize of a document's
// rows is what its 100 MB limit counts, every stored object among them (the
// owner's answer to Q14). unreferencedAt is when the image stopped appearing
// in its document, set by the collaboration server when it stores the document
// (src/lib/images/references.ts), and the row starts with it set: an image
// that was never placed is deleted as one that was taken out. The object and
// the row are deleted 30 days after it (src/lib/images/deletion.ts).
//
// Departures from Data models (docs/plan/slice-19.md, S19-7): deletionClaimedAt,
// the claim of that deletion, so that with two instances one of them deletes
// an image, in the manner of Document.deletionClaimedAt; and by hand in the
// migration, a check of the size and of the type. The document's relation
// restricts: the permanent deletion removes the objects and the rows first.
model DocumentImage {
  id                String    @id @default(cuid())
  documentId        String    @db.Uuid
  objectKey         String    @unique
  contentType       String
  byteSize          Int
  uploadedById      String
  createdAt         DateTime  @default(now())
  unreferencedAt    DateTime?
  deletionClaimedAt DateTime?

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId])
}

// ─── Account deletion (FR-AU-58; Data models, "Account deletion in Closed α") ─

// One row for each confirmed deletion of an account, written in the transaction
// that checks that the account owns no document (src/lib/account/deletion.ts).
// It records which steps of FR-AU-58 have succeeded, so that a step that failed
// is repeated until it succeeds, and it stays with the tombstone: it holds the
// internal user identifier and the times of the steps, and no personal field
// (§2.7, "The record of an account deletion").
//
// The steps run in order, and the database holds them to it: a step's time is
// set only where the step before it has been (the checks in the migration).
// The step (a), the closing of the connections, is the confirmation itself and
// has no column: from the row's existence the account makes no request and
// signs in nowhere. `rowsDoneAt` is the steps (e) and (f) together, one
// transaction, because (f) finds the invitations addressed to the account by
// the address that (e) clears.
//
// Two departures from Data models (docs/plan/slice-22.md, S22-1, S22-2):
// `feedbackSkippedAt`, because FR-AU-58 (c) says the step "is recorded as
// skipped" and a null `feedbackDoneAt` cannot be told from a step that is owed
// once the switch is on; and `claimedAt`, the claim of the timer, in the manner
// of `Document.deletionClaimedAt`, so that with two instances one of them
// carries out the steps (NFR-RE-15).
model AccountDeletion {
  id                String    @id @default(cuid())
  userId            String    @unique
  requestedAt       DateTime  @default(now())
  istoricoDoneAt    DateTime?
  feedbackDoneAt    DateTime?
  feedbackSkippedAt DateTime?
  feedbackAgainDoneAt DateTime?
  credentialsDoneAt DateTime?
  rowsDoneAt        DateTime?
  completedAt       DateTime?
  claimedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// ─── Clearing the documents (FR-AU-91; Data models, "Clearing") ──────────────

enum ClearingScope {
  ALL
  DELETED_ONLY
}

// One row for each confirmed clearing of an account's documents, written in the transaction of the
// confirmation (src/lib/clearing/clearing.ts) so that the clearing completes without the user
// (NFR-RE-15). `documentIds` are the documents the user confirmed, fixed at the confirmation: only
// those are deleted, each idempotently, and a document the account comes to own afterwards is never
// touched by it. `sharedDocumentIds` are those of them that were shared at the confirmation: they are
// deleted at `deleteSharedAt`, 7 days later, and the others at once. `cancelledDocumentIds` are the
// documents taken out of the clearing, by the Owner's cancellation or because their ownership passed
// to another account (docs/plan/slice-23.md, S23-4): none of them is deleted by it.
//
// Two departures from Data models (S23-3, S23-4): `emailsClaimedAt`, the claim of the one email each
// collaborator is sent, set before any is handed over; and the use of `cancelledDocumentIds` for a
// document whose ownership passed. By hand in the migration: the checks that tie the lists together.
// It holds an account identifier and document identifiers and no personal field (§2.7).
model DocumentClearing {
  id                   String        @id @default(cuid())
  userId               String
  scope                ClearingScope
  documentIds          String[]      @default([]) @db.Uuid
  sharedDocumentIds    String[]      @default([]) @db.Uuid
  cancelledDocumentIds String[]      @default([]) @db.Uuid
  requestedAt          DateTime      @default(now())
  deleteSharedAt       DateTime?
  completedAt          DateTime?
  emailsClaimedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}
