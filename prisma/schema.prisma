// The application's schema. The schema `ekdotico`, its roles and its grants are
// created by scripts/provision.sql and never by a migration (contract IC-51).
// No `vector` extension is declared: α 0.1.0 stores none (contract IC-23).
// A model arrives with the slice that first uses it, and of a model only the
// columns that slice uses (Data models, "What α 0.1.0 migrates").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity ────────────────────────────────────────────────────────────────
// The five tables of the identity library, Better Auth, in the application
// schema (FR-AU-05, NFR-SE-17 (b)). Their names and columns follow the library
// at its pinned version, 1.7.7, and were checked against it when it was
// installed (register D96). `User` is the library's table, extended.

model User {
  id            String   @id
  // Null only on the tombstone of a deleted account (FR-AU-58 (e)).
  name          String?
  // Lower case; unique without regard to case because it is stored lower case (FR-AU-02).
  email         String?  @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  twoFactorEnabled Boolean @default(false)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row for each credential of a user. The only provider is `credential`,
// whose row holds the salted scrypt hash of the password (NFR-SE-17 (a)).
model Account {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  accountId  String
  password   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // The library's columns for OAuth tokens. No OAuth is installed, so they stay
  // null, and a test asserts it; but the library refuses to start without them.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// The secret and the recovery codes are stored encrypted under a key held in
// the environment (NFR-SE-17 (a)). The last three columns are the library's own
// at 1.7.7 and are not on the Data models page.
model TwoFactor {
  id                      String    @id
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
}

// ── Security log ────────────────────────────────────────────────────────────
// One row for each event NFR-SE-19 lists. An entry holds the time, the kind,
// the application's user identifier and the document identifier, "and nothing
// else about a person": a column added here is how personal data would get in,
// and a test fails on one. The kinds are text, listed in src/lib/security-log.ts.
//
// No relation to `User` or to a document, on purpose: an entry outlives the
// row it names (a deleted document, a tombstone), and a sign-in refused for an
// unknown address has no user. Entries are deleted after their retention, by
// the time, hence the index (NFR-RE-15).
model SecurityLogEntry {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  kind       String
  // The identity library's identifier of a user (`User.id`).
  userId     String?
  // `Document.id`, a UUID.
  documentId String?  @db.Uuid

  @@index([createdAt])
}
