// The application's schema. The schema `ekdotico`, its roles and its grants are
// created by scripts/provision.sql and never by a migration (contract IC-51).
// No `vector` extension is declared: α 0.1.0 stores none (contract IC-23).
// A model arrives with the slice that first uses it, and of a model only the
// columns that slice uses (Data models, "What α 0.1.0 migrates"). `Verification`
// and `TwoFactor` arrive unused: the identity library refuses to start without them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity ────────────────────────────────────────────────────────────────
// The five tables of the identity library, Better Auth, in the application
// schema (FR-AU-05, NFR-SE-17 (b)). Their names and columns follow the library
// at its pinned version, 1.7.7, and were checked against it when it was
// installed (register D96). `User` is the library's table, extended.

model User {
  id            String   @id
  // Null only on the tombstone of a deleted account (FR-AU-58 (e)).
  name          String?
  // Lower case; unique without regard to case because it is stored lower case (FR-AU-02).
  email         String?  @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  twoFactorEnabled Boolean @default(false)

  // FR-AU-81: sign-in is refused until this time, after the twentieth failed
  // sign-in in any hour. Set by the server alone (NFR-SE-17 (d)); null, or a
  // time that has passed, is no lock (src/lib/auth/sign-in-lock.ts).
  lockedUntil DateTime?

  // The acknowledgement of the Closed α notice (FR-AU-56): the server time it
  // was made and the version of the notice acknowledged. Both null until the
  // account acknowledges.
  closedAlphaNoticeAcknowledgedAt DateTime?
  closedAlphaNoticeVersion        Int?

  sessions          Session[]
  accounts          Account[]
  twoFactor         TwoFactor?
  // FR-AU-09: at most one, by the unique `Workspace.ownerId`.
  personalWorkspace Workspace? @relation("PersonalWorkspace")
  // FR-ED-19: the documents the account is the Owner of.
  ownedDocuments    Document[] @relation("DocumentOwner")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row for each credential of a user. The only provider is `credential`,
// whose row holds the salted scrypt hash of the password (NFR-SE-17 (a)).
model Account {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  accountId  String
  password   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // The library's columns for OAuth tokens. No OAuth is installed, so they stay
  // null, and a test asserts it; but the library refuses to start without them.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// The secret and the recovery codes are stored encrypted under a key held in
// the environment (NFR-SE-17 (a)). The last three columns are the library's own
// at 1.7.7 and are not on the Data models page. `verified` is false from the
// password of an enrolment to its first code, and only a verified row is a
// second factor (FR-AU-83: "only then is it on"). The other two belong to a
// lock of the library's own, which nothing here reaches: the codes are checked
// by the application's endpoints (src/lib/auth/two-factor.ts), and the only
// count is that of NFR-SE-07. They stay 0 and null, and a test asserts it.
// `verified` is false unless a writer says otherwise (the library's default is
// true): a row written without it is no second factor.
model TwoFactor {
  id                      String    @id
  // One row for an account (Data models): an enrolment begun again replaces it.
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  // When the password began the enrolment, and again each time it is begun
  // again: a secret waits for its first code no longer than a second step
  // waits for its code (two-factor.ts). Not on the Data models page.
  createdAt               DateTime  @default(now())

  @@index([secret])
}

// ── Security log ────────────────────────────────────────────────────────────
// One row for each event NFR-SE-19 lists. An entry holds the time, the kind,
// the application's user identifier and the document identifier, "and nothing
// else about a person": a column added here is how personal data would get in,
// and a test fails on one. The kinds are text, listed in src/lib/security-log.ts.
//
// No relation to `User` or to a document, on purpose: an entry outlives the
// row it names (a deleted document, a tombstone), and a sign-in refused for an
// unknown address has no user. Entries are deleted after their retention, by
// the time, hence the index (NFR-RE-15).
model SecurityLogEntry {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  kind       String
  // The identity library's identifier of a user (`User.id`).
  userId     String?
  // `Document.id`, a UUID.
  documentId String?  @db.Uuid

  @@index([createdAt])
}

// ── Admission ───────────────────────────────────────────────────────────────
// One row for each invitation by which the team admits a person to Closed α
// (FR-AU-89), created on a signed request. The link's token is stored only as
// a hash, and `requestId` makes a repeated request harmless. On acceptance the
// address becomes `User.email`.
//
// `state` is what was last written. "Expired" is told from `expiresAt` when a
// row is read (src/lib/admission/invitations.ts), so that an invitation is
// never open a moment past its expiry for want of a timer; EXPIRED is written
// only when the row is next changed.
//
// The migration adds what this file cannot say: a unique index on `email`
// over the PENDING rows alone, so that an address never has two open links.
model AdmissionInvitation {
  id           String         @id @default(cuid())
  // Null once cleared: 30 days after `revokedAt` or `expiresAt`, and when the
  // account made from it is deleted (FR-AU-58 (e), NFR-RE-15; a later slice).
  email        String?
  tokenHash    String         @unique
  requestId    String         @unique
  state        AdmissionState @default(PENDING)
  createdAt    DateTime       @default(now())
  expiresAt    DateTime
  // Not on the Data models page: the clearing of the address counts its 30
  // days from the revocation, which no other column records.
  revokedAt    DateTime?
  acceptedAt   DateTime?
  // The `User` created from it. No relation: the row outlives a tombstone.
  acceptedById String?

  @@index([email])
}

enum AdmissionState {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ── Workspaces ──────────────────────────────────────────────────────────────
// Personal workspaces only in this slice (Data models, "What α 0.1.0
// migrates"). A personal workspace is tied to its account by `ownerId`, which
// is unique, so an account never has two (FR-AU-09; register D61).
model Workspace {
  id        String        @id @default(cuid())
  type      WorkspaceType
  ownerId   String?       @unique
  createdAt DateTime      @default(now())

  owner     User?      @relation("PersonalWorkspace", fields: [ownerId], references: [id], onDelete: Restrict)
  documents Document[]
}

enum WorkspaceType {
  PERSONAL
  INSTITUTIONAL
}

// ── Documents ───────────────────────────────────────────────────────────────
// The columns of the slice that creates, lists and renames a document (Data
// models, "What α 0.1.0 migrates"), and `yjsState`, of the collaboration
// server. `deletedById` arrives with deletion, and `clearingAt` with the
// clearing of an account's documents.
//
// Neither relation deletes a document: a document goes by its own deletion
// (FR-ED-36) and never because its Owner's row or its workspace's row went
// (plan, C17).
//
// The migration adds what this file cannot say: that a title has 1 to 200
// characters.
model Document {
  // FR-ED-35: a UUID in canonical lower-case text, which is how PostgreSQL
  // writes one (contract IC-25). Version 4, issued by the database (plan, C16).
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // FR-AU-13: never changed after creation, but for a transfer of ownership.
  workspaceId       String
  // FR-ED-19: exactly one Owner, by `User.id` and never by an address (FR-AU-04).
  ownerId           String
  // FR-ED-35: at most 200 characters. Stored as written (NFR-SE-08).
  title             String         @default("Untitled document")
  // FR-ED-44, FR-ED-45: the permission set, stored whole: every permission of
  // the table for every role, the Reviewer column and the comment rows
  // included, written at creation with the defaults. A column and not rows,
  // because the set is read with the document on every request (FR-ED-39) and
  // is always read and written whole. Its form is in
  // src/lib/documents/permissions.ts, which is also the only reader: a cell the
  // table fixes is decided from the table, whatever is stored here.
  permissionSet     Json
  // NFR-RE-07: the document's live state, written by the collaboration server
  // and by nothing else. Null until the document is first stored. The encoding
  // is in src/lib/collab/state.ts, and only there.
  yjsState          Bytes?
  // FR-ED-43, contract IC-16: fixed at creation from the capability the
  // Istorico port reports, and never changed. No default, so that no row is
  // written without the capability having been read.
  recording         RecordingState
  // FR-ED-36: the soft deletion (Data models, "Soft delete"): when the Owner
  // deleted the document, and who did. Both null for a document that is not
  // deleted, and again after it is restored. The row and its state stay for
  // the retention, and are then deleted by the timer
  // (src/lib/documents/deletion.ts). `deletedById` is an identifier and no
  // relation, as the page has it. The index below is the two lists' (plan, C17).
  deletedAt         DateTime?
  deletedById       String?
  // NFR-RE-15, plan C8: the claim of the permanent deletion, so that with two
  // instances one of them deletes the document. Set by the instance that
  // takes it, and never cleared but where Istorico did not erase; a claim
  // that was not finished is taken over once it is an hour old. NOT on the
  // Data models page: reported to the owner, with the plan's choice.
  deletionClaimedAt DateTime?
  createdAt         DateTime       @default(now())
  // When the document was last EDITED: created, renamed, or its state stored.
  // Not `@updatedAt`, under which every write moves it, the deletion, the
  // restore and the claim among them, unless each remembers to pass the old
  // value (FR-ED-36: a restore returns the document "as it was at deletion").
  // The three writes that are edits set it themselves, and no other write
  // names it. The attribute is the client's and no part of the database, so
  // the column is as the migration made it: required, with no default.
  updatedAt         DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  owner     User      @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, deletedAt])
}

enum RecordingState {
  RECORDED
  UNRECORDED
}
